{
    "name": "Claude Code CLI",
    "id": "install-claude-code",
    "version": "1.1.2",
    "description": "Installs the Claude Code CLI globally",
    "options": {},
    "documentationURL": "https://github.com/user29a765b4/devcontainer-features/tree/main/src/install-claude-code",
    "licenseURL": "https://github.com/user29a765b4/devcontainer-features/blob/main/src/install-claude-code/LICENSE",
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code"
            ]
        }
    },
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/mnt/.claude"
    },
    "mounts": [
        {
            "source": "claude-code-${devcontainerId}",
            "target": "/mnt/.claude",
            "type": "volume"
        }
    ]
}