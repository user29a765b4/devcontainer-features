{
    "name": "Codex CLI",
    "id": "install-codex-cli",
    "version": "1.0.0",
    "description": "Installs the Codex CLI globally",
    "options": {},
    "documentationURL": "https://github.com/user29a765b4/devcontainer-features/tree/main/src/install-codex-cli",
    "licenseURL": "https://github.com/user29a765b4/devcontainer-features/blob/main/src/install-codex-cli/LICENSE",
    "customizations": {
        "vscode": {
            "extensions": [
                "openai.chatgpt"
            ]
        }
    },
    "mounts": [
        {
            "source": "${localWorkspaceFolderBasename}-codex-cli-${devcontainerId}",
            "target": "/home/${containerEnv:USER}/.codex",
            "type": "volume"
        }
    ]
}